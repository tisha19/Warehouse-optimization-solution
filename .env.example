# Self-hosted NIM (tried first)
NIM_BASE_URL=http://localhost:8000/v1
NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NIM_SUBAGENT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NIM_API_KEY=

# NVIDIA cloud NIM (used automatically when the self-hosted NIM is unreachable)
NIM_CLOUD_FALLBACK=true
NIM_CLOUD_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_CLOUD_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NIM_CLOUD_API_KEY=

# Production service endpoints
CUOPT_URL=http://localhost:8002
NEMO_GUARDRAILS_URL=http://localhost:8003
OPENSHELL_URL=http://localhost:8004

# Local enterprise data endpoints
WMS_URL=http://localhost:9001
ERP_URL=http://localhost:9002
FORECAST_URL=http://localhost:9003

# Workflow settings
APPROVAL_STORE=results/approvals.json
AGENT_REQUEST_TIMEOUT_SECONDS=30
AGENT_DRY_RUN=true