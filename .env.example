# Copy to .env and fill in the key. .env is gitignored; never commit a real key.
#
# These are the working values: both models are hosted by NVIDIA, and the local
# services are reached over the tunnels deploy/forwardallports.sh opens.

# ---------------------------------------------------------------- orchestrator
# Nemotron 3 Ultra plans the run and delegates to the specialists.
NIM_SUPERVISOR_BASE_URL=https://inference-api.nvidia.com/v1
NIM_SUPERVISOR_MODEL=nvidia/nvidia/nemotron-3-ultra
NIM_SUPERVISOR_API_KEY=

# ----------------------------------------------------------------- specialists
# Nemotron 3.5 Lightning answers the demand, inventory and warehouse questions,
# and is also the model the guardrails self-check runs on.
NIM_BASE_URL=https://inference-api.nvidia.com/v1
NIM_MODEL=nvidia/nvidia/nemotron-3.5-lightning
NIM_SUBAGENT_BASE_URL=https://inference-api.nvidia.com/v1
NIM_SUBAGENT_MODEL=nvidia/nvidia/nemotron-3.5-lightning
NIM_API_KEY=

# A long reasoning turn outlives the client default of 60s, which ends a run
# over a call that was healthy.
NIM_REQUEST_TIMEOUT_SECONDS=240

# ------------------------------------------------------ cloud NIM (off by now)
# Both models above are already hosted, so the fallback stays off.
NIM_CLOUD_FALLBACK=false
NIM_CLOUD_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_CLOUD_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_CLOUD_API_KEY=

# -------------------------------------------------------------- stack services
# Ports match deploy/cluster_up.sh. They sit in the 28xxx range because the
# compute node is shared and the usual defaults collide with other teams.
CUOPT_URL=http://127.0.0.1:28002
NEMO_GUARDRAILS_URL=http://127.0.0.1:28003
OPENSHELL_URL=http://127.0.0.1:28004

NEMO_GUARDRAILS_CONFIG_ID=warehouse
# The rails run a model before answering, so they need far longer than a plain
# HTTP call; at 30s every check timed out into the local fallback, which allows.
NEMO_GUARDRAILS_TIMEOUT_SECONDS=180

# ------------------------------------------------------ local enterprise mocks
WMS_URL=http://localhost:9001
ERP_URL=http://localhost:9002
FORECAST_URL=http://localhost:9003

# ----------------------------------------------------------- workflow settings
APPROVAL_STORE=results/approvals.json
AGENT_REQUEST_TIMEOUT_SECONDS=300
AGENT_DRY_RUN=true

# Set to "process" so an already-exported variable beats this file. The batch
# job uses it to pin the port it actually bound.
# WAREHOUSE_ENV_PRECEDENCE=process