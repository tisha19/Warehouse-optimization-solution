# Cluster deployment settings. Edit before running the numbered scripts.
# All scripts source this file.

# ---------------------------------------------------------------------------
# NGC / registry
# ---------------------------------------------------------------------------
# Get an NGC API key from https://ngc.nvidia.com  (Setup -> API Key)
export NGC_API_KEY="${NGC_API_KEY:-}"
export NGC_REGISTRY="nvcr.io"

# Local cache so models are downloaded once, not per container restart.
export NIM_CACHE_DIR="${NIM_CACHE_DIR:-$HOME/.cache/nim}"

# ---------------------------------------------------------------------------
# Container images
# ---------------------------------------------------------------------------
# IMPORTANT: verify the exact repository + tag for your entitlement in the NGC
# catalog before running. Tags change between releases; do not assume.
#   https://catalog.ngc.nvidia.com/  ->  search the model  ->  "Get Container"
export NIM_SUPERVISOR_IMAGE="${NIM_SUPERVISOR_IMAGE:-nvcr.io/nim/nvidia/nemotron-3-ultra-550b-a55b:latest}"
export NIM_SUBAGENT_IMAGE="${NIM_SUBAGENT_IMAGE:-nvcr.io/nim/nvidia/nemotron-3-nano-30b-a3b:latest}"
export CUOPT_IMAGE="${CUOPT_IMAGE:-nvcr.io/nvidia/cuopt/cuopt:latest}"
export GUARDRAILS_IMAGE="${GUARDRAILS_IMAGE:-nvcr.io/nvidia/nemo-guardrails:latest}"

# ---------------------------------------------------------------------------
# Model identifiers advertised by each NIM (must match /v1/models output)
# ---------------------------------------------------------------------------
export NIM_MODEL="${NIM_MODEL:-nvidia/nemotron-3-ultra-550b-a55b}"
export NIM_SUBAGENT_MODEL="${NIM_SUBAGENT_MODEL:-nvidia/nemotron-3-nano-30b-a3b}"

# ---------------------------------------------------------------------------
# GPU placement — set per node topology (nvidia-smi -L)
# ---------------------------------------------------------------------------
# Nemotron 3 Ultra is a large MoE model and needs multiple GPUs.
export SUPERVISOR_GPUS="${SUPERVISOR_GPUS:-0,1,2,3,4,5,6,7}"
export SUBAGENT_GPUS="${SUBAGENT_GPUS:-8}"
export CUOPT_GPUS="${CUOPT_GPUS:-9}"

# ---------------------------------------------------------------------------
# Ports (host side)
# ---------------------------------------------------------------------------
export NIM_SUPERVISOR_PORT="${NIM_SUPERVISOR_PORT:-8000}"
export NIM_SUBAGENT_PORT="${NIM_SUBAGENT_PORT:-8010}"
export CUOPT_SERVER_PORT="${CUOPT_SERVER_PORT:-5000}"
export CUOPT_ADAPTER_PORT="${CUOPT_ADAPTER_PORT:-8002}"
export GUARDRAILS_PORT="${GUARDRAILS_PORT:-8003}"
export OPENSHELL_PORT="${OPENSHELL_PORT:-8004}"
export ENTERPRISE_GATEWAY_PORT="${ENTERPRISE_GATEWAY_PORT:-9100}"
export APP_PORT="${APP_PORT:-8080}"

# Hostname the application uses to reach the services above.
export SERVICE_HOST="${SERVICE_HOST:-127.0.0.1}"

# ---------------------------------------------------------------------------
# Cloud fallback — used automatically when the self-hosted NIM is unreachable
# ---------------------------------------------------------------------------
export NIM_CLOUD_FALLBACK="${NIM_CLOUD_FALLBACK:-true}"
export NIM_CLOUD_BASE_URL="${NIM_CLOUD_BASE_URL:-https://integrate.api.nvidia.com/v1}"
export NIM_CLOUD_MODEL="${NIM_CLOUD_MODEL:-nvidia/nemotron-3-ultra-550b-a55b}"
export NIM_CLOUD_API_KEY="${NIM_CLOUD_API_KEY:-}"

# ---------------------------------------------------------------------------
# Enterprise data sources
# ---------------------------------------------------------------------------
# Point these at the real WMS/ERP/forecast APIs when they exist. Leaving them on
# the synthetic gateway keeps the planner runnable but the data is NOT real.
export WMS_URL="${WMS_URL:-http://${SERVICE_HOST}:${ENTERPRISE_GATEWAY_PORT}}"
export ERP_URL="${ERP_URL:-http://${SERVICE_HOST}:${ENTERPRISE_GATEWAY_PORT}}"
export FORECAST_URL="${FORECAST_URL:-http://${SERVICE_HOST}:${ENTERPRISE_GATEWAY_PORT}}"
